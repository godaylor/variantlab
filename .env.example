# Optional production integrations. The pinned local build/dev scripts inject
# non-secret loopback placeholders so Milestone 1 works fully offline.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
VARIANTLAB_SITE_URL=http://localhost:3000
NEXT_PUBLIC_MARBLE_API_URL=https://api.marblecms.com
DATABASE_URL=postgresql://user:password@localhost:5432/variantlab
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
UPSTASH_REDIS_REST_URL=https://replace.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-me
MARBLE_WORKSPACE_KEY=replace-me
FREESOUND_CLIENT_ID=replace-me
FREESOUND_API_KEY=replace-me
